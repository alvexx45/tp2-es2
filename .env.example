# Banco de dados (PostgreSQL 17)
POSTGRES_USER=mvp
POSTGRES_PASSWORD=mvp_senha_dev
POSTGRES_DB=mvp_tempo_parado

# Segredo usado para assinar os tokens JWT — TROQUE em produção
JWT_SECRET=troque-este-segredo-em-producao

# Executa o seed (dados de exemplo) na primeira subida da API
SEED_ON_START=true

# Portas expostas no host (opcional — mude se a porta já estiver em uso)
DB_PORT=5432
API_PORT=3000
WEB_PORT=8080
